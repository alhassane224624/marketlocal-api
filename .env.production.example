# Variables à saisir dans Render (onglet Environment). Ne jamais committer le vrai fichier.
APP_NAME=MarketLocal
APP_ENV=production
APP_DEBUG=false
APP_KEY=                       # php artisan key:generate --show
APP_URL=https://marketlocal-api.onrender.com
FRONTEND_URL=https://marketlocal.vercel.app

LOG_CHANNEL=stderr
CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

# Aiven MySQL (onglet Overview du service)
DB_CONNECTION=mysql
DB_HOST=mysql-xxxx.aivencloud.com
DB_PORT=12345
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=
DB_CA_CERT=                    # coller TOUT le contenu de ca.pem (Aiven > Overview > CA certificate)

# Stripe (mode test)
STRIPE_SECRET=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_CURRENCY=mad
STRIPE_CONNECT_COUNTRY=FR

# Cloudinary (images : le disque de Render est effacé à chaque redémarrage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

CASH_ON_DELIVERY_ENABLED=true
CASH_ON_DELIVERY_MAX_TOTAL=0
